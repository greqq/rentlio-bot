# Rentlio API
RENTLIO_API_KEY=your_rentlio_api_key
RENTLIO_API_URL=https://api.rentl.io/v1

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Self check-in form ---
# Public origin the guest links are built from, no trailing slash.
# Without this the bot still runs, but /link cannot produce a link.
PUBLIC_BASE_URL=https://sun-apartments.co
# Set to false to run the bot with no web server at all.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Where tokens and pending submissions are stored (mount this path!).
DB_PATH=/app/data/bot.sqlite3
# How long a check-in link stays usable.
CHECKIN_TOKEN_TTL_DAYS=30
# Largest ID photo accepted, in bytes (default 12 MB).
MAX_UPLOAD_BYTES=12582912
