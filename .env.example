# Rentlio API
RENTLIO_API_KEY=your_rentlio_api_key
RENTLIO_API_URL=https://api.rentl.io/v1

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Occupancy analysis (/analiza)
# Optional: only needed if the account has more than one property
RENTLIO_PROPERTY_ID=
# Optional: number of apartments, used when a quiet period hides one of them
RENTLIO_TOTAL_UNITS=2

# Anthropic (optional) - AI commentary on top of the occupancy analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_ADVISOR_EFFORT=medium

# Lowest price per apartment the analysis may ever recommend.
#
# Compared against the STANDARD rate - the single number per date the API
# returns, which the channel-specific plans derive from. So the figure here
# belongs on that scale (the Booking tier), not on a derived one: a floor
# taken from a cheaper direct-booking tier lets the standard rate fall
# further than intended, and every derived plan with it.
#
# A sensible choice is the lowest standard-rate tier already sold, e.g. the
# 3+ night Booking price. Leave empty to disable the floor.
PRICE_FLOORS=Sunrise:55,Sunset:60
